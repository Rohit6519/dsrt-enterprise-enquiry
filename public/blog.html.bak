<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="A place for DSRT AI perspectives on AI infrastructure, model orchestration, engineering and responsible adoption."><title>Insights | DSRT AI</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><style>
:root{--ink:#17191c;--muted:#626a73;--line:#e5e7eb;--soft:#f7f8fa;--blue:#2457c5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:#fff;font:16px/1.65 Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.global-header{height:72px;padding:0 clamp(20px,5vw,76px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);position:sticky;top:0;z-index:50}.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.03em}.brand img{width:32px;height:32px;object-fit:contain}.global-header nav,.header-actions{display:flex;align-items:center;gap:28px;font-size:13px;color:#414850}.global-header nav a:hover,.header-actions a:hover{color:var(--blue)}.header-cta{background:#17191c;color:#fff!important;padding:9px 16px;border-radius:6px}.mobile-menu{display:none;background:#fff;border:1px solid var(--line);border-radius:6px;padding:8px}.page-hero{padding:100px clamp(22px,9vw,140px) 82px;background:#fff;border-bottom:1px solid var(--line)}.eyebrow{font:600 11px/1.4 'IBM Plex Mono',monospace;letter-spacing:.13em;text-transform:uppercase;color:#68717a;margin:0 0 22px}.page-hero h1{font-size:clamp(42px,6.5vw,76px);line-height:1.04;letter-spacing:-.055em;max-width:900px;margin:0 0 24px;font-weight:600}.page-hero p{font-size:18px;line-height:1.7;color:var(--muted);max-width:700px;margin:0 0 30px}.text-link{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;border-bottom:1px solid #17191c;padding:8px 0}.content-section{padding:76px clamp(22px,9vw,140px)}.section-heading{max-width:650px;margin-bottom:34px}.section-heading h2{font-size:clamp(28px,4vw,42px);letter-spacing:-.04em;line-height:1.15;margin:0 0 12px}.section-heading p{color:var(--muted);margin:0}.content-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.content-card{border:1px solid var(--line);border-radius:10px;padding:26px;background:#fff;min-height:150px}.content-card .number{font:12px 'IBM Plex Mono',monospace;color:#8b929a}.content-card h3{font-size:18px;margin:18px 0 8px;letter-spacing:-.02em}.content-card p{font-size:14px;color:var(--muted);margin:0;max-width:58ch}.page-cta{margin:0 clamp(22px,9vw,140px) 80px;padding:34px;border:1px solid var(--line);border-radius:10px;background:var(--soft);display:flex;align-items:center;justify-content:space-between;gap:24px}.page-cta h2{font-size:24px;margin:0}.page-cta a{background:#17191c;color:white;padding:11px 18px;border-radius:6px;font-size:13px;font-weight:600}.global-footer{padding:52px clamp(22px,6vw,90px) 24px;background:#f7f8fa;border-top:1px solid var(--line);display:grid;grid-template-columns:2fr repeat(3,1fr);gap:30px}.global-footer strong{display:block;margin-bottom:14px;font-size:13px}.global-footer p,.global-footer a{font-size:13px;color:var(--muted)}.global-footer a{display:block;margin:8px 0}.global-footer a:hover{color:var(--blue)}.footer-bottom{grid-column:1/-1;border-top:1px solid var(--line);padding-top:18px;margin-top:20px;display:flex;justify-content:space-between;color:#777;font-size:12px}.footer-bottom span{display:flex;gap:12px}.footer-bottom span a{display:inline;margin:0}@media(max-width:800px){.global-header nav,.header-actions{display:none}.mobile-menu{display:block}.global-header.menu-open nav{display:flex;position:absolute;top:72px;left:0;right:0;padding:18px 24px;background:white;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:16px}.page-hero{padding-top:70px}.content-grid{grid-template-columns:1fr}.page-cta{margin-bottom:48px;align-items:flex-start;flex-direction:column}.global-footer{grid-template-columns:repeat(2,1fr)}.global-footer>div:first-child{grid-column:1/-1}.footer-bottom{flex-direction:column;gap:8px}}
</style>  <link rel="stylesheet" href="assets/css/professional.css">
